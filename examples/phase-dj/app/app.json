{
  "expo": {
    "name": "PHASE",
    "slug": "phase-dj",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "phase",
    "backgroundColor": "#0A0B0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.phase.dj",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PHASE records your mixes so you can publish them to your feed.",
        "NSAppleMusicUsageDescription": "PHASE reads your music library so you can load your own tracks onto the decks.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.phase.dj",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO"
      ]
    },
    "splash": {
      "backgroundColor": "#0A0B0F",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
